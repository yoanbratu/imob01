{
  "entities": {
    "Property": {
      "title": "Property",
      "description": "Imóvel residencial ou comercial cadastrado com dados públicos e campos confidenciais de administração.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "purpose": { "type": "string", "enum": ["Venda", "Locação"] },
        "type": { "type": "string" },
        "category": { "type": "array" },
        "country": { "type": "string", "enum": ["Brasil", "Estados Unidos", "Paraguai"] },
        "city": { "type": "string" },
        "neighborhood": { "type": "string" },
        "stateOrDept": { "type": "string" },
        "address": { "type": "string" },
        "zipCode": { "type": "string" },
        "priceFormatted": { "type": "string" },
        "salePrice": { "type": "string" },
        "rentPrice": { "type": "string" },
        "iptu": { "type": "string" },
        "condoName": { "type": "string" },
        "condoFee": { "type": "string" },
        "priceNote": { "type": "string" },
        "areaM2": { "type": "number" },
        "bedrooms": { "type": "number" },
        "suites": { "type": "number" },
        "bathrooms": { "type": "number" },
        "parkingSpots": { "type": "number" },
        "featured": { "type": "boolean" },
        "featuredInQuickSuggestions": { "type": "boolean" },
        "youtubeUrl": { "type": "string" },
        "virtualTour360Url": { "type": "string" },
        "virtualTour360Image": { "type": "string" },
        "images": { "type": "array" },
        "description": { "type": "string" },
        "highlights": { "type": "array" },
        "amenities": { "type": "array" },
        "ownerName": { "type": "string" },
        "ownerPhone": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "ownerDocument": { "type": "string" },
        "ownerBankDetails": { "type": "string" },
        "ownerMinNegotiationValue": { "type": "string" },
        "realtorName": { "type": "string" },
        "realtorCreci": { "type": "string" },
        "realtorPhone": { "type": "string" },
        "realtorEmail": { "type": "string" },
        "realtorCommission": { "type": "string" },
        "adminNotes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["code", "title", "purpose", "type", "country", "city", "priceFormatted", "areaM2"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Contatos e propostas enviados por clientes ou proprietários.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "interest": { "type": "string" },
        "propertyCode": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "phone"]
    },
    "Realtor": {
      "title": "Realtor",
      "description": "Corretores cadastrados para gestão de imóveis e atendimento comercial.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "creci": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "defaultCommission": { "type": "string" },
        "specialty": { "type": "string" },
        "active": { "type": "boolean" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "phone"]
    },
    "PropertyOwner": {
      "title": "PropertyOwner",
      "description": "Proprietários de imóveis com dados de contato, bancários e margem de negociação.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "document": { "type": "string" },
        "bankDetails": { "type": "string" },
        "minNegotiationValue": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "phone"]
    },
    "Condominium": {
      "title": "Condominium",
      "description": "Condomínios e edifícios cadastrados com valores de taxa, endereço, comodidades e notas.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "condoFee": { "type": "string" },
        "address": { "type": "string" },
        "neighborhood": { "type": "string" },
        "city": { "type": "string" },
        "stateOrDept": { "type": "string" },
        "country": { "type": "string" },
        "zipCode": { "type": "string" },
        "amenities": { "type": "array" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name"]
    },
    "HomepageSegment": {
      "title": "HomepageSegment",
      "description": "Configurações e dados visuais dos segmentos da página inicial (fotos, títulos, textos e destaques).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "segmentTag": { "type": "string" },
        "title": { "type": "string" },
        "badge": { "type": "string" },
        "imageUrl": { "type": "string" },
        "imageBadge": { "type": "string" },
        "description": { "type": "string" },
        "features": { "type": "array" },
        "ctaText": { "type": "string" },
        "category": { "type": "string" },
        "footerLabel": { "type": "string" },
        "techEffect": { "type": "string" },
        "headerTag": { "type": "string" },
        "headerTitle": { "type": "string" },
        "headerDescription": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "imageUrl"]
    }
  },
  "firestore": {
    "/properties/{propertyId}": {
      "schema": { "$ref": "#/entities/Property" },
      "description": "Catálogo de imóveis com dados públicos e confidenciais de administração."
    },
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Propostas e contatos enviados via formulário."
    },
    "/realtors/{realtorId}": {
      "schema": { "$ref": "#/entities/Realtor" },
      "description": "Lista de corretores autorizados cadastrados na imobiliária."
    },
    "/owners/{ownerId}": {
      "schema": { "$ref": "#/entities/PropertyOwner" },
      "description": "Lista de proprietários cadastrados com informações sigilosas."
    },
    "/condominiums/{condominiumId}": {
      "schema": { "$ref": "#/entities/Condominium" },
      "description": "Lista de condomínios e edifícios cadastrados para preenchimento de taxas e especificações."
    },
    "/homepage_segments/{segmentId}": {
      "schema": { "$ref": "#/entities/HomepageSegment" },
      "description": "Segmentos 01 e 02 configuráveis na página de abertura com efeitos tecnológicos e fotos customizadas."
    }
  }
}
