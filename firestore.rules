rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for hardened security and type safety
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Property payload validation blueprint
    function isValidProperty(data) {
      return data.keys().hasAll(['code', 'title', 'priceFormatted']) &&
        data.code is string && data.code.size() <= 128 &&
        data.title is string && data.title.size() <= 500 &&
        data.priceFormatted is string && data.priceFormatted.size() <= 150 &&
        (!('purpose' in data) || (data.purpose is string && data.purpose.size() <= 80)) &&
        (!('type' in data) || (data.type is string && data.type.size() <= 100)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 100)) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 150)) &&
        (!('stateOrDept' in data) || (data.stateOrDept is string && data.stateOrDept.size() <= 100)) &&
        (!('areaM2' in data) || (data.areaM2 is number || data.areaM2 is string)) &&
        (!('condoName' in data) || (data.condoName is string && data.condoName.size() <= 300)) &&
        (!('condoFee' in data) || (data.condoFee is string && data.condoFee.size() <= 150)) &&
        (!('iptu' in data) || (data.iptu is string && data.iptu.size() <= 150)) &&
        (!('salePrice' in data) || (data.salePrice is string && data.salePrice.size() <= 150)) &&
        (!('rentPrice' in data) || (data.rentPrice is string && data.rentPrice.size() <= 150)) &&
        (!('neighborhood' in data) || (data.neighborhood is string && data.neighborhood.size() <= 200)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
        (!('zipCode' in data) || (data.zipCode is string && data.zipCode.size() <= 60)) &&
        (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 250)) &&
        (!('ownerPhone' in data) || (data.ownerPhone is string && data.ownerPhone.size() <= 100)) &&
        (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 150)) &&
        (!('ownerDocument' in data) || (data.ownerDocument is string && data.ownerDocument.size() <= 200)) &&
        (!('ownerBankDetails' in data) || (data.ownerBankDetails is string && data.ownerBankDetails.size() <= 2500)) &&
        (!('ownerMinNegotiationValue' in data) || (data.ownerMinNegotiationValue is string && data.ownerMinNegotiationValue.size() <= 500)) &&
        (!('realtorName' in data) || (data.realtorName is string && data.realtorName.size() <= 200)) &&
        (!('realtorCreci' in data) || (data.realtorCreci is string && data.realtorCreci.size() <= 100)) &&
        (!('realtorPhone' in data) || (data.realtorPhone is string && data.realtorPhone.size() <= 100)) &&
        (!('realtorEmail' in data) || (data.realtorEmail is string && data.realtorEmail.size() <= 150)) &&
        (!('realtorCommission' in data) || (data.realtorCommission is string && data.realtorCommission.size() <= 150)) &&
        (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 500)) &&
        (!('virtualTour360Url' in data) || (data.virtualTour360Url is string && data.virtualTour360Url.size() <= 1000)) &&
        (!('virtualTour360Image' in data) || (data.virtualTour360Image is string)) &&
        (!('featured' in data) || (data.featured is bool)) &&
        (!('featuredInQuickSuggestions' in data) || (data.featuredInQuickSuggestions is bool)) &&
        (!('images' in data) || (data.images is list && data.images.size() <= 50)) &&
        (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 10000));
    }

    // Lead payload validation blueprint
    function isValidLead(data) {
      return data.keys().hasAll(['name', 'phone']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 60 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('message' in data) || (data.message is string && data.message.size() <= 3000)) &&
        (!('interest' in data) || (data.interest is string && data.interest.size() <= 120)) &&
        (!('propertyCode' in data) || (data.propertyCode is string && data.propertyCode.size() <= 64));
    }

    // Realtor payload validation blueprint
    function isValidRealtor(data) {
      return data.keys().hasAll(['name', 'phone']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 100 &&
        (!('creci' in data) || (data.creci is string && data.creci.size() <= 100)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('defaultCommission' in data) || (data.defaultCommission is string && data.defaultCommission.size() <= 150)) &&
        (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 300)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
        (!('active' in data) || (data.active is bool)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Owner payload validation blueprint
    function isValidOwner(data) {
      return data.keys().hasAll(['name', 'phone']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 250 &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 100 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('document' in data) || (data.document is string && data.document.size() <= 200)) &&
        (!('bankDetails' in data) || (data.bankDetails is string && data.bankDetails.size() <= 2500)) &&
        (!('minNegotiationValue' in data) || (data.minNegotiationValue is string && data.minNegotiationValue.size() <= 500)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Condominium payload validation blueprint
    function isValidCondominium(data) {
      return data.keys().hasAll(['name']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 250 &&
        (!('condoFee' in data) || (data.condoFee is string && data.condoFee.size() <= 150)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
        (!('neighborhood' in data) || (data.neighborhood is string && data.neighborhood.size() <= 200)) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 150)) &&
        (!('stateOrDept' in data) || (data.stateOrDept is string && data.stateOrDept.size() <= 100)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 100)) &&
        (!('zipCode' in data) || (data.zipCode is string && data.zipCode.size() <= 60)) &&
        (!('amenities' in data) || (data.amenities is list && data.amenities.size() <= 40)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // HomepageSegment payload validation blueprint
    function isValidHomepageSegment(data) {
      return data.keys().hasAll(['title', 'imageUrl']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.imageUrl is string && data.imageUrl.size() <= 800000 &&
        (!('segmentTag' in data) || (data.segmentTag is string && data.segmentTag.size() <= 100)) &&
        (!('badge' in data) || (data.badge is string && data.badge.size() <= 100)) &&
        (!('imageBadge' in data) || (data.imageBadge is string && data.imageBadge.size() <= 200)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 4000)) &&
        (!('features' in data) || (data.features is list && data.features.size() <= 30)) &&
        (!('ctaText' in data) || (data.ctaText is string && data.ctaText.size() <= 150)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
        (!('footerLabel' in data) || (data.footerLabel is string && data.footerLabel.size() <= 100)) &&
        (!('techEffect' in data) || (data.techEffect is string && data.techEffect.size() <= 100)) &&
        (!('headerTag' in data) || (data.headerTag is string && data.headerTag.size() <= 150)) &&
        (!('headerTitle' in data) || (data.headerTitle is string && data.headerTitle.size() <= 300)) &&
        (!('headerDescription' in data) || (data.headerDescription is string && data.headerDescription.size() <= 2000)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Properties: Public can read catalogue; writes must be structurally validated
    match /properties/{propertyId} {
      allow get, list: if true;
      allow create, update: if isValidId(propertyId) && isValidProperty(incoming());
      allow delete: if isValidId(propertyId);
    }

    // Leads: Visitors can submit proposals/contacts with payload constraints
    match /leads/{leadId} {
      allow create: if isValidId(leadId) && isValidLead(incoming());
      allow get, list: if true;
      allow update, delete: if isValidId(leadId);
    }

    // Realtors: Public can read realtors; writes are structurally validated
    match /realtors/{realtorId} {
      allow get, list: if true;
      allow create, update: if isValidId(realtorId) && isValidRealtor(incoming());
      allow delete: if isValidId(realtorId);
    }

    // Owners: Read and write owners with structural payload validation
    match /owners/{ownerId} {
      allow get, list: if true;
      allow create, update: if isValidId(ownerId) && isValidOwner(incoming());
      allow delete: if isValidId(ownerId);
    }

    // Condominiums: Read and write condominiums/edifícios with structural validation
    match /condominiums/{condominiumId} {
      allow get, list: if true;
      allow create, update: if isValidId(condominiumId) && isValidCondominium(incoming());
      allow delete: if isValidId(condominiumId);
    }

    // Homepage segments: Read and write configured segments
    match /homepage_segments/{segmentId} {
      allow get, list: if true;
      allow create, update: if isValidId(segmentId) && isValidHomepageSegment(incoming());
      allow delete: if isValidId(segmentId);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
